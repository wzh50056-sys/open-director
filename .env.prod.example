# 复制为 .env.prod 后填写真实值；不要把 .env.prod 提交到 Git。
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://example.com
SESSION_SECRET=请替换为至少32位随机字符串

# 阿里云 RDS MySQL：ECS、RDS 使用同一地域和 VPC，填写 RDS 内网地址。
DATABASE_URL=mysql://数据库账号:数据库密码@rm-xxxxxxxx.mysql.rds.aliyuncs.com:3306/opendirector
DIRECT_URL=mysql://数据库账号:数据库密码@rm-xxxxxxxx.mysql.rds.aliyuncs.com:3306/opendirector

# 阿里云 Tair/Redis：填写内网地址。若实例启用了 TLS，代码还需增加 TLS 连接配置。
REDIS_HOST=r-xxxxxxxx.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_PASSWORD=请填写Tair密码
RENDER_QUEUE_NAME=open-director-render
WORKER_CONCURRENCY=1

# 阿里云 OSS：Bucket 与 ECS 尽量同地域。
S3_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
S3_PUBLIC_ENDPOINT=https://cdn.example.com
S3_REGION=cn-hangzhou
S3_BUCKET=open-director-prod
S3_ACCESS_KEY_ID=请填写RAM用户AccessKeyId
S3_SECRET_ACCESS_KEY=请填写RAM用户AccessKeySecret
S3_FORCE_PATH_STYLE=false

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
WAVESPEED_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
BATCH_TTS_PROVIDER=edge
BATCH_EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

